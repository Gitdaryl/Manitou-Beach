      "first_message": "Hey there! Welcome to Manitou Beach. I'm your local guide — ask me anything about the lake, events, businesses, fishing, wineries, or just what's happening around here. What can I help you with?",
      "language": "en",
      "hinglish_mode": false,
      "dynamic_variables": {
        "dynamic_variable_placeholders": {}
      },
      "disable_first_message_interruptions": false,
      "max_conversation_duration_message": "",
      "text_behavior_overrides": null,
